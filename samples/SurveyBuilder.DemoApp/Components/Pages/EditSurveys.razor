@page "/listsurveys/edit/{Id}"
@using SurveyBuilder.Components
@using SurveyBuilder.DemoApp.Components.Infrastructure
@using SurveyBuilder.Models
@using SurveyBuilder.Services
@inject ISurveyRepository Repo
@inject ISurveyJsonService JsonService
@inject NavigationManager Nav

<h3>Edit Survey</h3>

@if (Survey == null)
{
    <MudText Color="Color.Error">Survey not found</MudText>
}
else
{
    <SurveyBuilderEditor Survey="Survey" SurveyChanged="OnSurveyChanged" />

    <MudText Typo="Typo.subtitle2" Class="mt-4">Serialized Output:</MudText>
    <MudTextField @bind-Value="Serialized" Lines="20" FullWidth="true" ReadOnly="true" />

    <MudStack Class="d-flex justify-center mt-4">
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" StartIcon="@Icons.Material.Filled.Save">
            Save to DB
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    private SurveyModel? Survey;
    private string Serialized = "";

    protected override void OnInitialized()
    {
        var loaded = Repo.GetById(Id);

        if (loaded is not null)
        {
            // Detach from repo to prevent accidental mutation
            Survey = JsonService.Deserialize(JsonService.Serialize(loaded));
            Serialized = JsonService.Serialize(Survey);
        }
    }

    private Task OnSurveyChanged(SurveyModel updated)
    {
        Survey = updated;
        Serialized = JsonService.Serialize(updated);
        return Task.CompletedTask;
    }

    private void Save()
    {
        if (Survey is not null)
        {
            Console.WriteLine("Save triggered:");
            Console.WriteLine(Serialized);

            Repo.Update(Survey);
            Nav.NavigateTo("/listsurveys");
        }
    }
}
