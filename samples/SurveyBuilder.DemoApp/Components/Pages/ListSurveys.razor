@*List to display surveys*@

@page "/listsurveys"
@using SurveyBuilder.DemoApp.Components.Infrastructure
@using SurveyBuilder.Models
@using MudBlazor
@inject ISurveyRepository Repo
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Surveys</PageTitle>

<MudPaper Class="p-4 pa-5">
    <MudStack Row="true" Class="d-flex align-center mb-4 justify-space-between">
        <MudText Typo="Typo.h5">Your Surveys</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="pa-2"
                   OnClick="@(() => Nav.NavigateTo("/listsurveys/createsurvey"))">
            Create New Survey
        </MudButton>
    </MudStack>

    @if (Repo.GetAll().Count == 0)
    {
        <MudPaper Class="pa-10 text-center">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                No surveys created yet. Click "Create New Survey" to get started.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="pa-0">
            @foreach (var survey in Repo.GetAll())
            {
                <MudDivider />

                <MudStack 
                    Row="true" 
                    Class="d-flex align-center p-3 py-2 hover:bg-grey-lighten-3 transition-all justify-space-between"
                    Style="border-radius: 8px;">
                

                    <MudStack Row="false" Spacing="1">
                        <MudText Typo="Typo.subtitle1">@survey.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@survey.Description</MudText>
                    </MudStack>

                    <MudStack Row="true" Spacing="3">

                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => OpenPreviewDialog(survey))">
                            Preview
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => Nav.NavigateTo($"/listsurveys/edit/{survey.Id}"))">
                            Edit
                        </MudButton>

                        <MudButton Class="px-1" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="@(() => ConfirmDelete(survey))">
                            Delete
                        </MudButton>
                    </MudStack>
                </MudStack>
            }

            <MudDivider />
        </MudPaper>
    }
</MudPaper>

@code {
    private async Task ConfirmDelete(SurveyModel survey)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        bool? confirmed = await DialogService.ShowMessageBox(
            title: "Delete Survey",
            markupMessage: (MarkupString)$"Are you sure you want to delete <b>{survey.Title}</b>?",
            yesText: "Delete", noText: "Cancel",
            options: options
        );

        if (confirmed == true)
        {
            Repo.Delete(survey.Id);
            StateHasChanged();
        }
    }

    private async Task OpenPreviewDialog(SurveyModel survey)
    {
        var parameters = new DialogParameters
        {
            { "Survey", survey }
        };

        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<SurveyPreviewDialog>("Preview Survey", parameters, options);
    }
}
