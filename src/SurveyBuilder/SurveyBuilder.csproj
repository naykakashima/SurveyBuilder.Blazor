<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace>SurveyBuilder</RootNamespace>
    <PackageId>SurveyBuilder</PackageId>
  </PropertyGroup>
  <PropertyGroup>
    <Version>1.1.10</Version>
    <Authors>Kay</Authors>
    <Company>naykakashima</Company>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/naykakashima/SurveyBuilder.Blazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/naykakashima/SurveyBuilder.Blazor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Initial release of SurveyBuilder - enjoy!</PackageReleaseNotes>
    <Description>Reusable Blazor components to build and render surveys dynamically, inspired by SurveyJS.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageTags>blazor, survey, forms, components</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.7" />
    <PackageReference Include="MudBlazor" Version="8.9.0" />
  </ItemGroup>
</Project>